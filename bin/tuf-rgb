"""
TUF-RGB Backend Helper: Communicates with ITE5570 LampArray controller.
Packaged for GNOME Shell Extension tuf-rgb.
"""

import colorsys
import fcntl
import glob
import json
import math
import os
import signal
import sys
import time
from pathlib import Path

COLOR_PRESETS = [
    ("red", (255, 0, 0)),
    ("orange", (255, 102, 0)),
    ("yellow", (255, 204, 0)),
    ("green", (0, 230, 0)),
    ("cyan", (0, 213, 255)),
    ("blue", (0, 85, 255)),
    ("purple", (153, 0, 255)),
    ("white", (255, 255, 255)),
]

CONFIG_DIR = Path.home() / ".config" / "tuf-rgb"
STATE_FILE = CONFIG_DIR / "state.json"
PID_FILE = CONFIG_DIR / "effect.pid"

HIDIOCSFEATURE_BASE = 0xC0004806


def hidiocsfeature(length: int) -> int:
    return HIDIOCSFEATURE_BASE | (length << 16)


def find_hidraw():
    for p in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            uevent_path = os.path.join(p, "device", "uevent")
            if not os.path.exists(uevent_path):
                continue
            with open(uevent_path, "r", encoding="utf-8", errors="ignore") as f:
                uevent = f.read()
            if "0B05:000019B6" in uevent or "0B05:19B6" in uevent or "ITE5570" in uevent:
                dev_node = f"/dev/{os.path.basename(p)}"
                if os.path.exists(dev_node):
                    return dev_node
        except Exception:
            continue
    return None


def check_permission(dev_path):
    if not dev_path or not os.path.exists(dev_path):
        return "missing"
    if os.access(dev_path, os.R_OK | os.W_OK):
        return "ok"
    return "denied"


def load_state():
    defaults = {
        "index": 0,
        "color_name": "red",
        "r": 255,
        "g": 0,
        "b": 0,
        "intensity": 255,
        "effect": "static",
        "speed": 0.5,
        "on": True,
        "auto": False,
    }
    if STATE_FILE.exists():
        try:
            data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                defaults.update(data)
                return defaults
        except Exception:
            pass
    return defaults


def save_state(state):
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        tmp_file = CONFIG_DIR / f"state.json.tmp.{os.getpid()}"
        tmp_file.write_text(json.dumps(state, indent=2), encoding="utf-8")
        tmp_file.replace(STATE_FILE)
    except Exception:
        pass


def is_daemon_running():
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text(encoding="utf-8").strip())
            os.kill(pid, 0)
            return pid
        except (ValueError, OSError, ProcessLookupError):
            try:
                PID_FILE.unlink(missing_ok=True)
            except Exception:
                pass
    return None


def stop_effect_daemon():
    pid = is_daemon_running()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            for _ in range(10):
                time.sleep(0.04)
                os.kill(pid, 0)
        except OSError:
            pass
        try:
            PID_FILE.unlink(missing_ok=True)
        except Exception:
            pass


def _effect_loop(dev_path):
    try:
        PID_FILE.write_text(str(os.getpid()), encoding="utf-8")
    except Exception:
        pass

    running = True

    def _sig_handler(signum, frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, _sig_handler)
    signal.signal(signal.SIGINT, _sig_handler)

    fd = None
    try:
        fd = os.open(dev_path, os.O_RDWR | os.O_CLOEXEC)
    except Exception:
        sys.exit(1)

    try:
        arm_pkt = bytes([0x5F, 0x01] + [0x00] * 49)
        fcntl.ioctl(fd, hidiocsfeature(len(arm_pkt)), arm_pkt)
    except Exception:
        pass

    try:
        ctrl_pkt = bytes([0x46, 0x00])
        fcntl.ioctl(fd, hidiocsfeature(len(ctrl_pkt)), ctrl_pkt)
    except Exception:
        pass

    state = load_state()
    last_check = 0.0
    last_mtime = 0.0

    try:
        while running:
            now = time.time()
            if now - last_check > 0.2:
                last_check = now
                if STATE_FILE.exists():
                    try:
                        mtime = STATE_FILE.stat().st_mtime
                        if mtime != last_mtime:
                            last_mtime = mtime
                            state = load_state()
                    except Exception:
                        pass

            if not state.get("on", True):
                break

            effect = state.get("effect", "static")
            if effect == "static":
                break

            speed = max(0.05, min(1.0, float(state.get("speed", 0.5))))
            max_intensity = state.get("intensity", 255)
            min_intensity = max(5, int(max_intensity * 0.06))

            r = state.get("r", 255)
            g = state.get("g", 0)
            b = state.get("b", 0)
            cur_intensity = max_intensity

            if effect == "cycle":
                rate = 0.04 + speed * 0.25
                hue = (now * rate) % 1.0
                hr, hg, hb = colorsys.hsv_to_rgb(hue, 1.0, 1.0)
                r, g, b = int(hr * 255), int(hg * 255), int(hb * 255)
                cur_intensity = max_intensity

            elif effect == "breathe":
                freq = 0.2 + speed * 0.9
                factor = (math.sin(now * 2 * math.pi * freq - math.pi / 2) + 1.0) / 2.0
                cur_intensity = int(min_intensity + factor * (max_intensity - min_intensity))

            elif effect == "heartbeat":
                period = 2.4 - speed * 1.5
                phase = (now % period) / period
                if phase < 0.15:
                    sub = phase / 0.15
                    factor = math.sin(sub * math.pi)
                elif phase < 0.23:
                    factor = 0.0
                elif phase < 0.38:
                    sub = (phase - 0.23) / 0.15
                    factor = 0.75 * math.sin(sub * math.pi)
                else:
                    factor = 0.0
                cur_intensity = int(min_intensity + factor * (max_intensity - min_intensity))

            try:
                pkt = bytes([
                    0x45, 0x01, 0x00, 0x00, 0x00, 0x00,
                    max(0, min(255, r)),
                    max(0, min(255, g)),
                    max(0, min(255, b)),
                    max(0, min(255, cur_intensity)),
                ])
                fcntl.ioctl(fd, hidiocsfeature(len(pkt)), pkt)
            except BrokenPipeError:
                try:
                    os.close(fd)
                except Exception:
                    pass
                new_dev = find_hidraw()
                if new_dev:
                    try:
                        fd = os.open(new_dev, os.O_RDWR | os.O_CLOEXEC)
                    except Exception:
                        break
                else:
                    break
            except Exception:
                pass

            time.sleep(0.025)

    finally:
        if fd is not None:
            try:
                os.close(fd)
            except Exception:
                pass
        try:
            if PID_FILE.exists():
                pid_str = PID_FILE.read_text(encoding="utf-8").strip()
                if pid_str == str(os.getpid()):
                    PID_FILE.unlink(missing_ok=True)
        except Exception:
            pass


def spawn_effect_daemon(dev_path):
    stop_effect_daemon()
    try:
        pid = os.fork()
        if pid > 0:
            return
    except OSError:
        return

    os.setsid()
    try:
        pid = os.fork()
        if pid > 0:
            sys.exit(0)
    except OSError:
        sys.exit(1)

    try:
        sys.stdout.flush()
        sys.stderr.flush()
        with open("/dev/null", "r") as null_in, open("/dev/null", "a+") as null_out:
            os.dup2(null_in.fileno(), sys.stdin.fileno())
            os.dup2(null_out.fileno(), sys.stdout.fileno())
            os.dup2(null_out.fileno(), sys.stderr.fileno())
    except Exception:
        pass

    _effect_loop(dev_path)
    sys.exit(0)


def parse_color(arg):
    arg = arg.strip().lower()
    for name, (r, g, b) in COLOR_PRESETS:
        if arg == name:
            return r, g, b, name
    clean = arg.replace("#", "")
    if len(clean) == 6:
        try:
            return int(clean[0:2], 16), int(clean[2:4], 16), int(clean[4:6], 16), f"#{clean}"
        except ValueError:
            pass
    return None


def find_preset_index(r, g, b):
    for idx, (name, (pr, pg, pb)) in enumerate(COLOR_PRESETS):
        if (r, g, b) == (pr, pg, pb):
            return idx, name
    return None, None


def send_rgb(dev_path, r, g, b, intensity=255, autonomous=False):
    fd = os.open(dev_path, os.O_RDWR | os.O_CLOEXEC)
    try:
        try:
            arm_pkt = bytes([0x5F, 0x01] + [0x00] * 49)
            fcntl.ioctl(fd, hidiocsfeature(len(arm_pkt)), arm_pkt)
        except Exception:
            pass

        if autonomous:
            ctrl_pkt = bytes([0x46, 0x01])
            fcntl.ioctl(fd, hidiocsfeature(len(ctrl_pkt)), ctrl_pkt)
            return

        ctrl_pkt = bytes([0x46, 0x00])
        fcntl.ioctl(fd, hidiocsfeature(len(ctrl_pkt)), ctrl_pkt)

        color_pkt = bytes([
            0x45, 0x01, 0x00, 0x00, 0x00, 0x00,
            max(0, min(255, r)),
            max(0, min(255, g)),
            max(0, min(255, b)),
            max(0, min(255, intensity)),
        ])
        fcntl.ioctl(fd, hidiocsfeature(len(color_pkt)), color_pkt)
    finally:
        os.close(fd)


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(0)

    cmd = args[0].lower()

    if cmd == "device":
        dev = find_hidraw()
        if dev:
            print(dev)
            sys.exit(0)
        sys.exit(3)

    if cmd == "check":
        dev = find_hidraw()
        if not dev:
            sys.exit(3)
        status = check_permission(dev)
        if status == "ok":
            sys.exit(0)
        elif status == "denied":
            sys.exit(2)
        else:
            sys.exit(3)

    if cmd == "state":
        state = load_state()
        print(json.dumps(state, indent=2))
        sys.exit(0)

    # Optional retry support for standalone invocations
    retries = 1
    retry_delay = 0.5
    if cmd == "restore":
        if "--retries" in args:
            try:
                r_idx = args.index("--retries")
                retries = max(1, int(args[r_idx + 1]))
            except (ValueError, IndexError):
                retries = 1
        if "--delay" in args:
            try:
                d_idx = args.index("--delay")
                retry_delay = max(0.1, float(args[d_idx + 1]))
            except (ValueError, IndexError):
                retry_delay = 0.5

    dev = None
    perm_status = "missing"
    for attempt in range(retries):
        dev = find_hidraw()
        if dev:
            perm_status = check_permission(dev)
            if perm_status == "ok":
                break
        if attempt < retries - 1:
            time.sleep(retry_delay)

    if not dev or perm_status == "missing":
        sys.exit(3)

    if perm_status == "denied":
        sys.exit(2)

    state = load_state()

    try:
        if cmd == "restore":
            if not state.get("on", True):
                stop_effect_daemon()
                send_rgb(dev, 0, 0, 0, 0)
            elif state.get("auto", False):
                stop_effect_daemon()
                send_rgb(dev, 0, 0, 0, 0, autonomous=True)
            elif state.get("effect", "static") != "static":
                spawn_effect_daemon(dev)
            else:
                stop_effect_daemon()
                r = state.get("r", 255)
                g = state.get("g", 0)
                b = state.get("b", 0)
                intensity = state.get("intensity", 255)
                send_rgb(dev, r, g, b, intensity)
            sys.exit(0)

        elif cmd == "effect":
            if len(args) < 2:
                print(state.get("effect", "static"))
                sys.exit(0)

            eff_name = args[1].lower()
            if eff_name not in ("static", "breathe", "heartbeat", "cycle"):
                sys.exit(1)

            if "--speed" in args:
                try:
                    s_idx = args.index("--speed")
                    state["speed"] = max(0.05, min(1.0, float(args[s_idx + 1])))
                except (ValueError, IndexError):
                    pass

            state["effect"] = eff_name
            state["on"] = True
            state["auto"] = False
            save_state(state)

            if eff_name == "static":
                stop_effect_daemon()
                r = state.get("r", 255)
                g = state.get("g", 0)
                b = state.get("b", 0)
                intensity = state.get("intensity", 255)
                send_rgb(dev, r, g, b, intensity)
            else:
                spawn_effect_daemon(dev)

            sys.exit(0)

        elif cmd == "speed":
            if len(args) > 1:
                try:
                    val = float(args[1])
                    state["speed"] = max(0.05, min(1.0, val))
                    save_state(state)
                except ValueError:
                    sys.exit(1)
            sys.exit(0)

        elif cmd == "stop-effect":
            stop_effect_daemon()
            state["effect"] = "static"
            save_state(state)
            r = state.get("r", 255)
            g = state.get("g", 0)
            b = state.get("b", 0)
            intensity = state.get("intensity", 255)
            send_rgb(dev, r, g, b, intensity)
            sys.exit(0)

        elif cmd == "next":
            idx = (state.get("index", -1) + 1) % len(COLOR_PRESETS)
            name, (r, g, b) = COLOR_PRESETS[idx]
            state["index"] = idx
            state["color_name"] = name
            state["r"], state["g"], state["b"] = r, g, b
            state["on"] = True
            state["auto"] = False
            if state.get("effect") == "cycle":
                state["effect"] = "static"
                stop_effect_daemon()
            save_state(state)

            if state.get("effect", "static") == "static":
                intensity = state.get("intensity", 255)
                send_rgb(dev, r, g, b, intensity)

        elif cmd == "prev":
            idx = (state.get("index", 1) - 1) % len(COLOR_PRESETS)
            name, (r, g, b) = COLOR_PRESETS[idx]
            state["index"] = idx
            state["color_name"] = name
            state["r"], state["g"], state["b"] = r, g, b
            state["on"] = True
            state["auto"] = False
            if state.get("effect") == "cycle":
                state["effect"] = "static"
                stop_effect_daemon()
            save_state(state)

            if state.get("effect", "static") == "static":
                intensity = state.get("intensity", 255)
                send_rgb(dev, r, g, b, intensity)

        elif cmd == "toggle":
            if state.get("on", True):
                stop_effect_daemon()
                send_rgb(dev, 0, 0, 0, 0)
                state["on"] = False
            else:
                state["on"] = True
                if state.get("auto", False):
                    stop_effect_daemon()
                    send_rgb(dev, 0, 0, 0, 0, autonomous=True)
                elif state.get("effect", "static") != "static":
                    spawn_effect_daemon(dev)
                else:
                    r = state.get("r", 255)
                    g = state.get("g", 0)
                    b = state.get("b", 0)
                    intensity = state.get("intensity", 255)
                    send_rgb(dev, r, g, b, intensity)
            save_state(state)

        elif cmd == "auto":
            stop_effect_daemon()
            send_rgb(dev, 0, 0, 0, 0, autonomous=True)
            state["auto"] = True
            state["on"] = True
            state["effect"] = "static"
            save_state(state)

        elif cmd == "off":
            stop_effect_daemon()
            send_rgb(dev, 0, 0, 0, 0)
            state["on"] = False
            save_state(state)

        elif cmd == "brightness" and len(args) > 1:
            val = int(args[1])
            intensity = max(0, min(255, int(val * 255 / 100)))
            if intensity == 0:
                stop_effect_daemon()
                send_rgb(dev, 0, 0, 0, 0)
                state["on"] = False
                state["intensity"] = 0
            else:
                state["intensity"] = intensity
                state["on"] = True
                state["auto"] = False
                if state.get("effect", "static") == "static":
                    r = state.get("r", 255)
                    g = state.get("g", 0)
                    b = state.get("b", 0)
                    send_rgb(dev, r, g, b, intensity)
            save_state(state)

        else:
            color_res = parse_color(cmd)
            if color_res:
                r, g, b, col_name = color_res
                state["r"], state["g"], state["b"] = r, g, b
                state["color_name"] = col_name
                state["on"] = True
                state["auto"] = False

                preset_idx, _ = find_preset_index(r, g, b)
                if preset_idx is not None:
                    state["index"] = preset_idx

                # If in cycle mode, picking a color exits cycle mode into static
                if state.get("effect") == "cycle":
                    state["effect"] = "static"
                    stop_effect_daemon()
                    intensity = state.get("intensity", 255)
                    send_rgb(dev, r, g, b, intensity)
                elif state.get("effect", "static") == "static":
                    stop_effect_daemon()
                    intensity = state.get("intensity", 255)
                    send_rgb(dev, r, g, b, intensity)
                else:
                    # breathe or heartbeat continues with new color
                    if not is_daemon_running():
                        spawn_effect_daemon(dev)

                save_state(state)
            else:
                sys.exit(1)

    except PermissionError:
        sys.exit(2)
    except (FileNotFoundError, ProcessLookupError):
        sys.exit(3)
    except OSError as e:
        if e.errno in (13, 1):
            sys.exit(2)
        elif e.errno in (2, 19):
            sys.exit(3)
        else:
            sys.exit(1)
    except Exception:
        sys.exit(1)


if __name__ == "__main__":
    main()
